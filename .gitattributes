# Normalize line endings: store text as LF in the repo, check out as LF.
# Stops the "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.icns   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.aar    binary
*.jar    binary
*.so     binary
*.dll    binary
*.dylib  binary
*.a      binary
*.keystore binary
*.jks    binary
*.p12    binary
*.zip    binary
*.gz     binary
*.mp3    binary
*.mp4    binary

# Windows batch/cmd files genuinely need CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf
